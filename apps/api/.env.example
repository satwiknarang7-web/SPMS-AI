# SQLite for local development. Production targets PostgreSQL in an Australian region
# (change the datasource provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Interval in ms for the HQ sync worker and store metric collection.
SYNC_INTERVAL_MS=15000
# Auth tokens: access token lifetime (s), refresh token lifetime (h), absolute session lifetime (days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=12
SESSION_MAX_DAYS=7
# Account lockout after repeated failed sign-ins
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Rate limiting: general API (per user / IP) and sign-in endpoints (per IP + email)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW="15 minutes"
# PBS Data API v3 (public tier: ~1 request / 20 s). Leave blank to use the local catalogue.
PBS_API_KEY=""
PBS_API_BASE_URL="https://data-api.health.gov.au/pbs/api/v3"
